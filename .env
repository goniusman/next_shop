FRAMEWORK_PROVIDER="rest"
# NEXT_PUBLIC_REST_API_ENDPOINT="http://36.255.70.224/api"
NEXT_PUBLIC_REST_API_ENDPOINT="http://localhost:5000/api"
NEXT_PUBLIC_GRAPHQL_API_ENDPOINT="http://localhost:4000/graphql"
APPLICATION_MODE=production
NEXT_PUBLIC_ADMIN_URL="http://36.255.70.224:3002/login"

# Default Language
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Multilang
# Before enabling multilingual make sure your API supports multilingual
NEXT_PUBLIC_ENABLE_MULTI_LANG=true
NEXT_PUBLIC_AVAILABLE_LANGUAGES='en,zh,ar,de,es,he'

# API Key for third party service
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=dfs

# Social Authentication
NEXTAUTH_URL=http://localhost:3000
SECRET=dsf
GOOGLE_CLIENT_ID=sfdf
GOOGLE_CLIENT_SECRET=sdfs
